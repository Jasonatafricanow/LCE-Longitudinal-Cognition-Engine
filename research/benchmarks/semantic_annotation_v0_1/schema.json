{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jasonatafricanow/LCE/research/benchmarks/semantic_annotation_v0_1/schema.json",
  "title": "LCESemanticParsingGoldBenchmarkCaseV0_1",
  "description": "Schema for individual test cases in the LCE semantic parsing gold benchmark v0.1 (GitHub Issue #14).",
  "type": "object",
  "required": [
    "case_id",
    "split",
    "family",
    "adversarial",
    "raw_evidence",
    "semantic_blocks",
    "cutoff_time",
    "gold_document",
    "rationale"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "enum": ["dev", "eval"]
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "adversarial": {
      "type": "boolean"
    },
    "trap_description": {
      "type": ["string", "null"]
    },
    "raw_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "content", "occurred_at"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "occurred_at": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "semantic_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["block_id", "content", "occurred_start", "occurred_end", "raw_evidence_ids"],
        "properties": {
          "block_id": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "occurred_start": { "type": "string" },
          "occurred_end": { "type": "string" },
          "raw_evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "cutoff_time": {
      "type": "string"
    },
    "gold_document": {
      "type": "object",
      "required": ["document_id", "cutoff_time", "units", "relations"],
      "properties": {
        "document_id": { "type": "string" },
        "cutoff_time": { "type": "string" },
        "units": { "type": "array" },
        "relations": { "type": "array" },
        "metadata": { "type": "object" }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
