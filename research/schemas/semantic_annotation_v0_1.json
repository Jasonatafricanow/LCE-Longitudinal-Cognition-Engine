{
  "$defs": {
    "ArgumentMention": {
      "additionalProperties": false,
      "description": "A grounded argument mention with its own stable mention_id.",
      "properties": {
        "mention_id": {
          "description": "Stable unique mention identifier, e.g. 'm_001'",
          "minLength": 1,
          "title": "Mention Id",
          "type": "string"
        },
        "role": {
          "description": "Role from ROLE_VOCABULARY",
          "title": "Role",
          "type": "string"
        },
        "text": {
          "description": "Verbatim text or normalized argument string",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional exact span within raw evidence"
        },
        "entity_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional entity identifier or coreference key",
          "title": "Entity Ref"
        }
      },
      "required": [
        "mention_id",
        "role",
        "text"
      ],
      "title": "ArgumentMention",
      "type": "object"
    },
    "AttributionMode": {
      "enum": [
        "direct_speaker",
        "direct_quote",
        "indirect_report",
        "external_source",
        "unknown"
      ],
      "title": "AttributionMode",
      "type": "string"
    },
    "EpistemicHedge": {
      "description": "Explicit outer epistemic hedging decoupled from the inner proposition/desire modality.",
      "enum": [
        "none",
        "think",
        "probable",
        "uncertain",
        "doubt"
      ],
      "title": "EpistemicHedge",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "explicit",
        "entailed",
        "inferred",
        "unknown"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "ModalityType": {
      "enum": [
        "asserted",
        "possible",
        "hypothetical",
        "intended",
        "desired",
        "uncertain",
        "unknown"
      ],
      "title": "ModalityType",
      "type": "string"
    },
    "PolarityType": {
      "enum": [
        "positive",
        "negative",
        "unknown"
      ],
      "title": "PolarityType",
      "type": "string"
    },
    "PredicateNormalizationRule": {
      "description": "Deterministic mechanical normalization rules permitted in v0.1.",
      "enum": [
        "exact_surface",
        "lemma",
        "compound_lower",
        "frozen_map"
      ],
      "title": "PredicateNormalizationRule",
      "type": "string"
    },
    "PredicateSpec": {
      "additionalProperties": false,
      "description": "Deterministic mechanical predicate normalization.",
      "properties": {
        "surface_predicate": {
          "description": "Verbatim predicate/verb/expression from text",
          "minLength": 1,
          "title": "Surface Predicate",
          "type": "string"
        },
        "normalized_predicate": {
          "description": "Mechanically normalized predicate",
          "minLength": 1,
          "title": "Normalized Predicate",
          "type": "string"
        },
        "normalization_rule": {
          "$ref": "#/$defs/PredicateNormalizationRule",
          "description": "Deterministic normalization rule (exact_surface, lemma, compound_lower, frozen_map)"
        }
      },
      "required": [
        "surface_predicate",
        "normalized_predicate",
        "normalization_rule"
      ],
      "title": "PredicateSpec",
      "type": "object"
    },
    "RelationProvenance": {
      "additionalProperties": false,
      "description": "Independent grounding and provenance for a semantic relation.",
      "properties": {
        "raw_evidence_id": {
          "minLength": 1,
          "title": "Raw Evidence Id",
          "type": "string"
        },
        "semantic_block_id": {
          "minLength": 1,
          "title": "Semantic Block Id",
          "type": "string"
        }
      },
      "required": [
        "raw_evidence_id",
        "semantic_block_id"
      ],
      "title": "RelationProvenance",
      "type": "object"
    },
    "RelationType": {
      "enum": [
        "SAME_ENTITY",
        "SAME_EVENT",
        "BEFORE",
        "AFTER",
        "OVERLAP",
        "TEMPORAL_UNKNOWN",
        "CAUSE",
        "CONDITION",
        "PURPOSE",
        "CONTRAST",
        "CONCESSION",
        "EQUIVALENT",
        "INCOMPATIBLE",
        "NO_RELATION",
        "UNKNOWN"
      ],
      "title": "RelationType",
      "type": "string"
    },
    "SemanticRelation": {
      "additionalProperties": false,
      "description": "Typed relation linking two units or two stable mention IDs.",
      "properties": {
        "relation_id": {
          "minLength": 1,
          "title": "Relation Id",
          "type": "string"
        },
        "source_id": {
          "description": "Source endpoint: unit annotation_id (e.g. 'u1') or stable mention_id (e.g. 'm_001')",
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "description": "Target endpoint: unit annotation_id (e.g. 'u2') or stable mention_id (e.g. 'm_002')",
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/RelationType"
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "provenance": {
          "$ref": "#/$defs/RelationProvenance"
        },
        "supporting_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Supporting Spans",
          "type": "array"
        }
      },
      "required": [
        "relation_id",
        "source_id",
        "target_id",
        "relation_type",
        "evidence_status",
        "confidence",
        "provenance"
      ],
      "title": "SemanticRelation",
      "type": "object"
    },
    "SemanticUnit": {
      "additionalProperties": false,
      "description": "Atomic, source-grounded semantic unit (proposition, event, state, or attitude).",
      "properties": {
        "annotation_id": {
          "minLength": 1,
          "title": "Annotation Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/UnitProvenance"
        },
        "source_span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "kind": {
          "$ref": "#/$defs/UnitKind"
        },
        "predicate": {
          "$ref": "#/$defs/PredicateSpec"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/ArgumentMention"
          },
          "title": "Arguments",
          "type": "object"
        },
        "polarity": {
          "$ref": "#/$defs/PolarityType"
        },
        "modality": {
          "$ref": "#/$defs/ModalityType"
        },
        "epistemic_hedge": {
          "$ref": "#/$defs/EpistemicHedge",
          "default": "none",
          "description": "Outer epistemic hedging (e.g. 'think', 'probable') decoupled from inner matrix modality"
        },
        "holder_ref": {
          "description": "Entity reference of holder (e.g. 'user', 'Alice', 'VP', 'system', 'unknown')",
          "minLength": 1,
          "title": "Holder Ref",
          "type": "string"
        },
        "attribution_mode": {
          "$ref": "#/$defs/AttributionMode",
          "description": "Mode of attribution (direct_speaker, direct_quote, indirect_report, external_source, unknown)"
        },
        "temporal_anchoring": {
          "$ref": "#/$defs/TemporalAnchoring"
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "annotation_id",
        "provenance",
        "source_span",
        "kind",
        "predicate",
        "polarity",
        "modality",
        "holder_ref",
        "attribution_mode",
        "temporal_anchoring",
        "evidence_status",
        "confidence"
      ],
      "title": "SemanticUnit",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "Character offsets and verbatim text within a raw evidence source.",
      "properties": {
        "char_start": {
          "description": "0-indexed start offset",
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "description": "0-indexed end offset (exclusive)",
          "minimum": 1,
          "title": "Char End",
          "type": "integer"
        },
        "text": {
          "description": "Verbatim text span",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "char_start",
        "char_end",
        "text"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "TemporalAnchorType": {
      "enum": [
        "exact",
        "bounded_range",
        "relative",
        "unanchored"
      ],
      "title": "TemporalAnchorType",
      "type": "string"
    },
    "TemporalAnchoring": {
      "additionalProperties": false,
      "description": "Normalized temporal anchoring information with explicit reference anchor.",
      "properties": {
        "normalized_value": {
          "description": "ISO date/range or 'unknown'",
          "minLength": 1,
          "title": "Normalized Value",
          "type": "string"
        },
        "anchor_type": {
          "$ref": "#/$defs/TemporalAnchorType"
        },
        "source_expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verbatim temporal expression from span",
          "title": "Source Expression"
        },
        "reference_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference time anchor for relative expressions (e.g. 'evidence:occurred_at', 'doc_time')",
          "title": "Reference Anchor"
        }
      },
      "required": [
        "normalized_value",
        "anchor_type"
      ],
      "title": "TemporalAnchoring",
      "type": "object"
    },
    "UnitKind": {
      "enum": [
        "event",
        "state",
        "proposition",
        "attitude"
      ],
      "title": "UnitKind",
      "type": "string"
    },
    "UnitProvenance": {
      "additionalProperties": false,
      "description": "Mandatory upstream provenance linking back to raw evidence and boundary block.",
      "properties": {
        "raw_evidence_id": {
          "minLength": 1,
          "title": "Raw Evidence Id",
          "type": "string"
        },
        "semantic_block_id": {
          "minLength": 1,
          "title": "Semantic Block Id",
          "type": "string"
        }
      },
      "required": [
        "raw_evidence_id",
        "semantic_block_id"
      ],
      "title": "UnitProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A collection of semantic units and relations within a cutoff-bounded context.",
  "properties": {
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "cutoff_time": {
      "description": "ISO 8601 UTC cutoff timestamp",
      "title": "Cutoff Time",
      "type": "string"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/SemanticUnit"
      },
      "title": "Units",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/SemanticRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "document_id",
    "cutoff_time",
    "units",
    "relations"
  ],
  "title": "SemanticAnnotationDocument",
  "type": "object"
}