{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jasonatafricanow/LCE/research/schemas/semantic_annotation_v0_1.json",
  "title": "LCESemanticAnnotationDocumentV0_1",
  "description": "Frozen research schema for LCE semantic annotation v0.1 (GitHub Issue #13).",
  "type": "object",
  "required": ["document_id", "cutoff_time", "units", "relations"],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "cutoff_time": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp defining the cutoff boundary."
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemanticUnit"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemanticRelation"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SourceSpan": {
      "type": "object",
      "required": ["char_start", "char_end", "text"],
      "properties": {
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "UnitProvenance": {
      "type": "object",
      "required": ["raw_evidence_id", "semantic_block_id"],
      "properties": {
        "raw_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_block_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "TemporalAnchoring": {
      "type": "object",
      "required": ["value", "anchor_type"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "anchor_type": {
          "type": "string",
          "enum": ["exact", "bounded_range", "relative", "unanchored"]
        },
        "source_expression": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "SemanticUnit": {
      "type": "object",
      "required": [
        "annotation_id",
        "provenance",
        "source_span",
        "kind",
        "predicate",
        "arguments",
        "polarity",
        "modality",
        "holder",
        "temporal_anchoring",
        "evidence_status",
        "confidence"
      ],
      "properties": {
        "annotation_id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/UnitProvenance"
        },
        "source_span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "kind": {
          "type": "string",
          "enum": ["event", "state", "proposition", "attitude"]
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "actor",
              "experiencer",
              "theme",
              "target",
              "stimulus",
              "topic",
              "place",
              "reason",
              "purpose",
              "result",
              "time"
            ]
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "polarity": {
          "type": "string",
          "enum": ["positive", "negative", "unknown"]
        },
        "modality": {
          "type": "string",
          "enum": [
            "asserted",
            "possible",
            "hypothetical",
            "intended",
            "desired",
            "uncertain",
            "unknown"
          ]
        },
        "holder": {
          "type": "string",
          "enum": ["user", "quoted", "reported", "system", "unknown"]
        },
        "temporal_anchoring": {
          "$ref": "#/$defs/TemporalAnchoring"
        },
        "evidence_status": {
          "type": "string",
          "enum": ["explicit", "entailed", "inferred", "unknown"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": false
    },
    "SemanticRelation": {
      "type": "object",
      "required": [
        "relation_id",
        "source_id",
        "target_id",
        "relation_type",
        "evidence_status",
        "confidence"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "SAME_ENTITY",
            "SAME_EVENT",
            "BEFORE",
            "AFTER",
            "OVERLAP",
            "TEMPORAL_UNKNOWN",
            "CAUSE",
            "CONDITION",
            "PURPOSE",
            "CONTRAST",
            "CONCESSION",
            "EQUIVALENT",
            "INCOMPATIBLE",
            "NO_RELATION",
            "UNKNOWN"
          ]
        },
        "evidence_status": {
          "type": "string",
          "enum": ["explicit", "entailed", "inferred", "unknown"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "provenance_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceSpan"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
